<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>

<StackPane prefHeight="782.0" prefWidth="1278.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="SignController">

    <Canvas fx:id="weatherCanvas" width="1278.0" height="782.0"/>
    <ImageView fx:id="zoomedSign" pickOnBounds="true" preserveRatio="true" fitWidth="500"/>

    <BorderPane prefWidth="1278.0" prefHeight="782.0">
        <center>
            <VBox alignment="CENTER" spacing="16">
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="datePrev" text="&lt;"/>
                    <Label fx:id="dateLabel" text="Monday March 16"/>
                    <Button fx:id="dateNext" text="&gt;"/>
                </HBox>
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="timePrev" text="&lt;"/>
                    <Label fx:id="timeLabel" text="12:00 AM"/>
                    <Button fx:id="timeNext" text="&gt;"/>
                </HBox>
                <Label fx:id="selectedLocation" text=""/>
                <Label fx:id="selectedTemp" text=""/>
                <Label fx:id="selectedForecast" text=""/>
                <Label fx:id="selectedWind" text=""/>
                <Label fx:id="selectedPrecip" text=""/>
                <TextField fx:id="locationSearch" promptText="Search city..." maxWidth="300"/>
                <Button fx:id="backButton" text="Back"/>
                <Label fx:id="subtitleLabel" text=""/>
            </VBox>
        </center>
        <bottom>
            <HBox alignment="CENTER" spacing="20">
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>