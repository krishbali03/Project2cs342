<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>

<?import javafx.geometry.Insets?>
<StackPane fx:id="root" prefHeight="720" prefWidth="1280"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="MainController">

    <Canvas fx:id="weatherCanvas" width="1278" height="782"/>
    <ImageView fx:id="backgroundImage" fitWidth="1278" fitHeight="782" preserveRatio="false" smooth="false"/>

    <BorderPane prefWidth="1278" prefHeight="782" mouseTransparent="true">
        <bottom>
            <VBox alignment="BOTTOM_CENTER" spacing="4">
                <VBox.margin>
                    <Insets bottom="120.0"/>
                </VBox.margin>
                <Label fx:id="subtitleLabel" text="" styleClass="subtitle"/>
                <Label fx:id="examineLabel" text="" styleClass="subtitle"/>
            </VBox>
        </bottom>
    </BorderPane>

</StackPane>